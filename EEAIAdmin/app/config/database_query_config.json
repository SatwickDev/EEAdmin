    "lc_detail_view": {
      "allowed_filters": [
        {
          "field": "lc_applications.lc_id",
          "ops": [
            "="
          ],
          "type": "integer"
        },
        {
          "field": "lc_applications.applicant_ref",
          "ops": [
            "="
          ],
          "type": "string"
        }
      ],
      "base": "lc_applications",
      "default_limit": 1,
      "description": "Complete LC details with amendments",
      "id": "lc_detail_view",
      "joins": [
        {
          "alias": "amend",
          "from": "lc_applications.lc_id",
          "to": "lc_amendments.lc_id",
          "type": "left"
        },
        {
          "alias": "applicant",
          "from": "lc_applications.applicant_id",
          "to": "parties.party_id",
          "type": "inner"
        },
        {
          "alias": "beneficiary",
          "from": "lc_applications.beneficiary_id",
          "to": "parties.party_id",
          "type": "inner"
        }
      ],
      "module": "letters_of_credit",
      "name": "LC Detail View",
      "order_by": [
        "amend.amendment_date DESC"
      ],
      "select": [
        "lc_applications.*",
        "applicant.name as applicant_name",
        "applicant.swift_bic as applicant_bic",
        "applicant.country as applicant_country",
        "beneficiary.name as beneficiary_name",
        "beneficiary.swift_bic as beneficiary_bic",
        "beneficiary.country as beneficiary_country",
        "amend.amendment_number",
        "amend.field_name",
        "amend.old_value",
        "amend.new_value",
        "amend.amendment_date"
      ],
      "where": [
        "lc_applications.tenant_id = :tenant_id"
      ]
    },
