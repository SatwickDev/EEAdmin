  "tables": {
    "guarantee_claims": {
      "columns": [
        {
          "description": "Primary key",
          "name": "claim_id",
          "type": "integer"
        },
        {
          "description": "Foreign key to guarantees",
          "name": "guarantee_id",
          "type": "integer"
        },
        {
          "description": "Date claim was made",
          "name": "claim_date",
          "type": "date"
        },
        {
          "description": "Amount claimed",
          "name": "claim_amount",
          "type": "decimal"
        },
        {
          "description": "pending|approved|rejected|paid",
          "name": "claim_status",
          "type": "string"
        },
        {
          "description": "Reason for claim",
          "name": "claim_reason",
          "type": "text"
        },
        {
          "description": "Whether supporting documents received",
          "name": "documents_received",
          "type": "boolean"
        },
        {
          "description": "Date claim was paid (if approved)",
          "name": "payment_date",
          "type": "date"
        },
        {
          "description": "Multi-tenancy identifier",
          "name": "tenant_id",
          "type": "integer"
        }
      ],
      "description": "Claims made against bank guarantees",
      "fks": [
        {
          "column": "guarantee_id",
          "ref_column": "guarantee_id",
          "ref_table": "guarantees"
        }
      ],
      "id": "guarantee_claims",
      "indexes": [
        "guarantee_id",
        "claim_status",
        "claim_date",
        "tenant_id"
      ],
      "name": "Guarantee Claims",
      "pk": "claim_id",
      "rbac": {
        "read_roles": [
          "ops_analyst",
          "relationship_manager",
          "auditor",
          "admin"
        ],
        "write_roles": [
          "ops_analyst",
          "admin"
        ]
      }
    },
    "guarantees": {
      "columns": [
        {
          "description": "Primary key",
          "name": "guarantee_id",
          "type": "integer"
        },
        {
          "description": "Foreign key to parties",
          "name": "applicant_id",
          "type": "integer"
        },
        {
          "description": "Foreign key to parties",
          "name": "beneficiary_id",
          "type": "integer"
        },
        {
          "description": "performance|financial|advance_payment|bid_bond|SBLC",
          "name": "guarantee_type",
          "type": "string"
        },
        {
          "description": "ISO currency code",
          "name": "currency",
          "type": "string"
        },
        {
          "description": "Guarantee amount",
          "name": "amount",
          "type": "decimal"
        },
        {
          "description": "draft|issued|active|claimed|expired|cancelled",
          "name": "status",
          "type": "string"
        },
        {
          "description": "Issue date",
          "name": "issue_date",
          "type": "date"
        },
        {
          "description": "Expiry date",
          "name": "expiry_date",
          "type": "date"
        },
        {
          "description": "Reference to underlying contract",
          "name": "underlying_contract",
          "type": "string"
        },
        {
