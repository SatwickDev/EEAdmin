  "metadata": {
    "description": "Trade Finance Database Query Configuration - Module/Table Mapping, Recipes, and RBAC",
    "lastUpdated": "2025-10-26T18:31:16.070440",
    "maintainer": "Finstack Tech"
  },
  "modules": {
    "collections": {
      "description": "D/P and D/A collection transactions",
      "entry_tables": [
        "collections",
        "collection_documents"
      ],
      "icon": "mdi-inbox-multiple-outline",
      "id": "collections",
      "intents": {
        "list_pending": {
          "description": "Collections awaiting acceptance or payment",
          "recipe": "collection_pending_view"
        },
        "status_tracking": {
          "description": "Track collection status by reference",
          "recipe": "collection_detail_view"
        }
      },
      "name": "Documentary Collections"
    },
    "guarantees": {
      "description": "SBLC and other guarantee instruments lifecycle",
      "entry_tables": [
        "guarantees",
        "guarantee_claims"
      ],
      "icon": "mdi-shield-check-outline",
      "id": "guarantees",
      "intents": {
        "claims_history": {
          "description": "View claims against guarantees",
          "recipe": "guarantee_claims_view"
        },
        "list_active": {
          "description": "Active guarantees by beneficiary or type",
          "recipe": "guarantee_active_view"
        },
        "list_expiring": {
          "description": "Guarantees expiring soon",
          "recipe": "guarantee_expiring_view"
        }
      },
      "name": "Bank Guarantees"
    },
    "letters_of_credit": {
      "description": "Issuance & lifecycle of documentary LCs (MT700/707)",
      "entry_tables": [
        "lc_applications",
        "lc_amendments"
      ],
      "icon": "mdi-file-document-outline",
      "id": "letters_of_credit",
      "intents": {
        "amendments_history": {
          "description": "View all amendments for specific LCs",
          "recipe": "lc_amendments_view"
        },
        "detail_by_number": {
          "description": "Get full details of an LC by reference number",
          "recipe": "lc_detail_view"
        },
        "list_expired": {
          "description": "Find LCs that have already expired",
          "recipe": "lc_expired_view"
        },
        "list_expiring": {
          "description": "Find LCs expiring within a date range",
          "recipe": "lc_expiring_view"
        },
        "list_pending": {
          "description": "Find LCs that are approved but not issued, or issued not utilized",
          "recipe": "lc_pending_view"
        }
      },
      "name": "Letters of Credit"
    },
    "trade_finance": {
      "description": "Export/import financing, pre-shipment, post-shipment",
      "entry_tables": [
        "finance_applications",
        "disbursements"
      ],
      "icon": "mdi-cash-multiple",
      "id": "trade_finance",
      "intents": {
        "disbursement_tracking": {
          "description": "Track disbursements and repayments",
          "recipe": "disbursement_tracking_view"
        },
        "list_applications": {
          "description": "Finance applications by status",
          "recipe": "finance_applications_view"
        }
      },
      "name": "Trade Finance"
    }
  },
  "query_settings": {
    "allowed_operations": [
      "SELECT"
    ],
    "default_limit": 100,
    "denied_functions": [
      "EXEC",
      "EXECUTE",
      "xp_cmdshell"
    ],
    "enable_row_level_security": true,
    "log_all_queries": true,
    "max_joins": 5,
    "max_limit": 500,
    "require_tenant_filter": true,
    "statement_timeout_seconds": 30
  },
  "rbac_roles": {
    "admin": {
      "description": "Full system access",
      "id": "admin",
      "name": "Administrator",
      "permissions": [
        "read_all",
        "write_all",
        "delete_all",
        "configure"
      ]
    },
    "auditor": {
      "description": "Read-only access for compliance review",
      "id": "auditor",
      "name": "Auditor",
      "permissions": [
        "read_all_audit",
        "export_reports"
      ]
    },
    "ops_analyst": {
      "description": "Can view and process transactions",
      "id": "ops_analyst",
      "name": "Operations Analyst",
      "permissions": [
        "read_most",
        "write_transactions",
        "view_masked_data"
      ]
    },
    "relationship_manager": {
      "description": "Client relationship management",
      "id": "relationship_manager",
      "name": "Relationship Manager",
      "permissions": [
        "read_client_portfolio",
        "view_analytics"
      ]
    }
  },
  "recipes": {
    "guarantee_active_view": {
      "allowed_filters": [
        {
          "field": "beneficiary.name",
          "ops": [
            "=",
            "ILIKE"
          ],
          "type": "string"
        },
        {
          "field": "beneficiary.country",
          "ops": [
            "=",
            "IN"
          ],
          "type": "string"
        },
        {
          "field": "guarantees.guarantee_type",
          "ops": [
            "=",
            "IN"
          ],
          "type": "string"
        },
        {
          "field": "guarantees.amount",
          "ops": [
            ">=",
            "<=",
            "BETWEEN"
          ],
          "type": "decimal"
        }
      ],
      "base": "guarantees",
      "default_limit": 100,
      "description": "Currently active bank guarantees and SBLCs",
      "id": "guarantee_active_view",
      "joins": [
        {
          "alias": "applicant",
          "from": "guarantees.applicant_id",
          "to": "parties.party_id",
          "type": "inner"
        },
        {
          "alias": "beneficiary",
          "from": "guarantees.beneficiary_id",
          "to": "parties.party_id",
          "type": "inner"
        }
      ],
      "module": "guarantees",
      "name": "Active Guarantees View",
      "order_by": [
        "guarantees.expiry_date ASC"
      ],
      "select": [
        "guarantees.guarantee_id",
        "guarantees.guarantee_type",
        "guarantees.currency",
        "guarantees.amount",
        "guarantees.status",
        "guarantees.issue_date",
        "guarantees.expiry_date",
        "applicant.name as applicant_name",
        "beneficiary.name as beneficiary_name",
        "beneficiary.country as beneficiary_country"
      ],
      "where": [
        "guarantees.status IN ('issued', 'active')",
        "guarantees.expiry_date > CURRENT_DATE",
        "guarantees.tenant_id = :tenant_id"
      ]
    },
    "guarantee_claims_view": {
      "allowed_filters": [
        {
          "field": "guarantee_claims.claim_status",
          "ops": [
            "=",
            "IN"
          ],
          "type": "string"
        },
        {
          "field": "beneficiary.name",
          "ops": [
            "=",
            "ILIKE"
          ],
          "type": "string"
        },
        {
          "field": "guarantee_claims.claim_date",
          "ops": [
            ">=",
            "<=",
            "BETWEEN"
          ],
          "type": "date"
        }
      ],
      "base": "guarantee_claims",
      "default_limit": 100,
      "description": "Claims made against guarantees",
      "id": "guarantee_claims_view",
      "joins": [
        {
          "alias": "guarantee",
          "from": "guarantee_claims.guarantee_id",
          "to": "guarantees.guarantee_id",
          "type": "inner"
        },
        {
          "alias": "applicant",
          "from": "guarantees.applicant_id",
          "to": "parties.party_id",
          "type": "inner"
        },
        {
          "alias": "beneficiary",
          "from": "guarantees.beneficiary_id",
          "to": "parties.party_id",
          "type": "inner"
        }
      ],
      "module": "guarantees",
      "name": "Guarantee Claims View",
      "order_by": [
        "guarantee_claims.claim_date DESC"
      ],
      "select": [
        "guarantee_claims.claim_id",
        "guarantee_claims.claim_date",
        "guarantee_claims.claim_amount",
        "guarantee_claims.claim_status",
        "guarantee.guarantee_id",
        "guarantee.guarantee_type",
        "guarantee.amount as guarantee_amount",
        "applicant.name as applicant_name",
        "beneficiary.name as beneficiary_name"
      ],
      "where": [
        "guarantee_claims.tenant_id = :tenant_id"
      ]
    },
    "guarantee_expiring_view": {
