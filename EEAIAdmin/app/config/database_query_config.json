        {
          "field": "guarantees.amount",
          "ops": [
            ">=",
            "<=",
            "BETWEEN"
          ],
          "type": "decimal"
        }
      ],
      "base": "guarantees",
      "default_limit": 100,
      "description": "Guarantees expiring within specified date range",
      "id": "guarantee_expiring_view",
      "joins": [
        {
          "alias": "applicant",
          "from": "guarantees.applicant_id",
          "to": "parties.party_id",
          "type": "inner"
        },
        {
          "alias": "beneficiary",
          "from": "guarantees.beneficiary_id",
          "to": "parties.party_id",
          "type": "inner"
        }
      ],
      "module": "guarantees",
      "name": "Expiring Guarantees View",
      "order_by": [
        "guarantees.expiry_date ASC"
      ],
      "select": [
        "guarantees.guarantee_id",
        "guarantees.guarantee_type",
        "guarantees.currency",
        "guarantees.amount",
        "guarantees.status",
        "guarantees.issue_date",
        "guarantees.expiry_date",
        "guarantees.underlying_contract",
        "applicant.name as applicant_name",
        "applicant.country as applicant_country",
        "beneficiary.name as beneficiary_name",
        "beneficiary.country as beneficiary_country"
      ],
      "where": [
        "guarantees.status IN ('issued', 'active')",
