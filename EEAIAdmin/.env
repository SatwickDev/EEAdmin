# =============================================================================
# ORACLE DATABASE CONFIGURATION
# =============================================================================
# Main Oracle Database (EXIMTRX)
DB_USERNAME=EXIMTRX
DB_PASSWORD=EXIMTRX
DB_HOST=localhost
DB_PORT=1521
DB_DATABASE=DSCF

# CE Oracle Database (CETRX)
CE_DB_USERNAME=CETRX
CE_DB_PASSWORD=CETRX
CE_DB_HOST=localhost
CE_DB_PORT=1521
CE_DB_DATABASE=DSCF

# Oracle Client Library Path
ORACLE_CLIENT_LIB_DIR=C:\Users\AIAdmin\Downloads\instantclient-basic-windows.x64-23.8.0.25.04\instantclient_23_8

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================
# Mode: 'enabled' (all customers), 'disabled' (no customers), 'allowlist' (specific customers only)
CHROMA_MODE=enabled

# Comma-separated list of customer IDs for allowlist mode
# Example: CHROMA_CUSTOMERS=bank1,bank2,bank3
CHROMA_CUSTOMERS=

# ChromaDB server connection
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Legacy flags (optional, CHROMA_MODE takes precedence)
# CHROMA_ENABLED=false
# CHROMA_ENABLED_FOR_ALL=false

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
# Mode: 'enabled' (default) | 'disabled' (disables MongoDB completely)
MONGO_MODE=enabled

# Option 1: Use full connection string (recommended)
MONGO_URI=mongodb://localhost:27017/

# Option 2: Use individual parameters (URI takes precedence if both provided)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=

# Database configuration
DATABASE_NAME=finai_chatbot
MONGO_AUTH_SOURCE=admin

# Advanced options (optional)
MONGO_REPLICA_SET=
MONGO_SSL=false
MONGO_SSL_CERT_PATH=

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# Enable/disable Azure OpenAI (set to 'false' to disable)
AZURE_OPENAI_ENABLED=true

# Azure OpenAI API credentials
AZURE_OPENAI_API_BASE=https://newfinai-app.openai.azure.com
AZURE_OPENAI_API_KEY=1h36ydp0nY0qVtsIR7GjIr9cbyjBYtTPUIX21BH7PN1GuoEa8Tk8JQQJ99BIACYeBjFXJ3w3AAABACOGzSgi

# Azure OpenAI deployment and version
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
