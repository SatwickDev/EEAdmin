# =============================================================================
# API CONFIGURATION - OPENAI (NON-AZURE)
# =============================================================================
# Enable/disable OpenAI (set to 'true' to enable non-Azure OpenAI)
OPENAI_ENABLED=false

# OpenAI API credentials
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4

# =============================================================================
# API CONFIGURATION - ANTHROPIC
# =============================================================================
# Enable/disable Anthropic Claude (set to 'true' to enable)
ANTHROPIC_ENABLED=false

# Anthropic API credentials
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# API BEHAVIOR SETTINGS
# =============================================================================
# Default timeout for API calls (seconds)
API_TIMEOUT=30

# Retry configuration
API_MAX_RETRIES=3
API_RETRY_DELAY=1

# LLM parameters
API_TEMPERATURE=0.7
API_MAX_TOKENS=4000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# =============================================================================
# BRANDING CONFIGURATION
# =============================================================================
# Show/hide Finstack logo (true/false)
SHOW_FINSTACK_LOGO=true
# Logo file path (relative to static/img/)
LOGO_FILENAME=finstack.png

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable Admin Configuration feature (true/false)
ENABLE_ADMIN_CONFIG=true

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# SSL/TLS Configuration (default: true - auto-enables when certificates exist)
SSL_ENABLED=true
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem

# Server host and ports
SERVER_HOST=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80

# Development settings
DEBUG_MODE=true
ALLOW_UNSAFE_WERKZEUG=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# OTHER CONFIGURATION
# =============================================================================
ANONYMIZED_TELEMETRY=False
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
