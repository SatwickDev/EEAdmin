# Previous deployment options (commented out)
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-35-turbo

# =============================================================================
# AZURE EMBEDDING CONFIGURATION
# =============================================================================
AZURE_EMBEDDING_MODEL=text-embedding-3-large
